{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "drawio": {
        "type": "local",
        "command": ["npx", "-y", "@drawio/mcp"]
      },
      "excalidraw": {
        "type": "local",
        "command": ["npx", "-y", "@scofieldfree/excalidraw-mcp"]
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      },
      "fetch": {
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"]
      },
      "semgrep": {
        "type": "local",
        "command": ["uvx", "--from", "semgrep", "semgrep", "mcp", "-t", "stdio"],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      "snyk": {
        "type": "local",
        "command": ["npx", "-y", "snyk@latest", "mcp", "-t", "stdio"],
        "environment": {
          "SNYK_TOKEN": "{env:SNYK_TOKEN}",
          "SNYK_MCP_PROFILE": "lite"
        },
        "timeout": {
          "startup": 180000,
          "catalog": 120000
        }
      },
      "github": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "GITHUB_TOOLSETS": "context,repos,pull_requests,actions,git"
        },
        "timeout": {
          "startup": 180000,
          "catalog": 120000
        }
      },
      "docker-sandbox": {
        "type": "local",
        "command": ["uvx", "mcp-server-docker"],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      "infisical": {
        "type": "local",
        "command": ["npx", "-y", "@infisical/mcp"],
        "environment": {
          "INFISICAL_AUTH_METHOD": "universal-auth",
          "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}",
          "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}",
          "INFISICAL_MASK_SECRET_VALUES": "true"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        },
        "disabled": true
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "android": {
        "type": "local",
        "command": ["npx", "-y", "@us-all/android-mcp@1.14.4"],
        "environment": {
          "ANDROID_HOME": "C:\\Users\\Maria\\AppData\\Local\\Android\\Sdk",
          "ADB_PATH": "C:\\Users\\Maria\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe",
          "ANDROID_MCP_ALLOW_WRITE": "true",
          "ANDROID_MCP_ALLOW_SHELL": "false",
          "ANDROID_TOOLS": "device,apps,ui,logcat,emulator"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      "GitKraken": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@gitkraken/gk@3.1.77",
          "mcp",
          "--host=opencode",
          "--readonly"
        ],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      }
    }
  }
}
