{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "drawio": {
        "type": "local",
        "command": ["npx", "-y", "@drawio/mcp"]
      },
      "excalidraw": {
        "type": "local",
        "command": ["npx", "-y", "@scofieldfree/excalidraw-mcp"]
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      },
      "fetch": {
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"]
      },
      "semgrep": {
        "type": "local",
        "command": ["uvx", "--from", "semgrep", "semgrep", "mcp", "-t", "stdio"],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      "snyk": {
        "type": "local",
        "command": ["npx", "-y", "snyk@latest", "mcp", "-t", "stdio"],
        "environment": {
          "SNYK_TOKEN": "{env:SNYK_TOKEN}",
          "SNYK_MCP_PROFILE": "lite"
        },
        "timeout": {
          "startup": 180000,
          "catalog": 120000
        }
      },
      "github": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "GITHUB_TOOLSETS": "context,repos,pull_requests,actions,git"
        },
        "timeout": {
          "startup": 180000,
          "catalog": 120000
        }
      },
      "docker-sandbox": {
        "type": "local",
        "command": ["uvx", "mcp-server-docker"],
        "timeout": {
          "startup": 120000,
          "catalog": 120000
        }
      },
      "infisical": {
        "type": "local",
        "command": ["npx", "-y", "@infisical/mcp"],
        "environment": {
          "INFISICAL_TOKEN": "{env:INFISICAL_TOKEN}"
        },
        "disabled": true
      }
    }
  }
}
