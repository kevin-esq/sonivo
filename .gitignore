!.scratch/notes/.gitkeep
.scratch/**/*.local.md
.scratch/tmp/*
!.scratch/tmp/.gitkeep
.scratch/HANDOFF.md
.scratch/rls-build/
.scratch/rls-validation/
.scratch/backend.log
.scratch/backend.pid
.scratch/*-pid.txt
.scratch/dbtest.py
src/**/.scratch/rls-validation/
tests/**/.scratch/rls-validation/
.scratch/*.mjs
.scratch/shots/
.scratch/clyc-recon/
.scratch/clyc-recon/*.js
.scratch/clyc-recon/*.css
.scratch/clyc-recon/*.json
.scratch/clyc-recon/*.webmanifest

# Local editor / vault state (never committed)
.obsidian/
.rino/

# Impeccable engine binaries (reinstalled by `npx impeccable install`)
**/impeccable/scripts/bin/

# .NET
**/bin/
**/obj/
*.user
*.suo
.vs/

# Node / frontend
**/node_modules/
**/dist/
*.tsbuildinfo
web/apps/app/.next-e2e/
web/output/playwright/
output/playwright/
.turbo/
mobile/android/.gradle/
mobile/android/**/build/

# Playwright
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/
.playwright-mcp/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
*.log

# Visual/UX audit evidence (FASE 2 harness)
.visual-audit/

e2e/visual-audit/audit-output/


