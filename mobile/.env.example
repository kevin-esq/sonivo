# Copy this file to mobile/.env for your own deployment notes.
# Native clients do not load dotenv files automatically. See mobile/README.md
# for the Android build command and the iOS Xcode settings to populate.

# Public HTTPS API address. This is not a credential.
SONIVO_API_BASE_URL=https://api.sonivo.lat
SONIVO_OIDC_ISSUER=https://api.sonivo.lat
SONIVO_WEB_BASE_URL=https://app.sonivo.lat

# Set these on the API deployment after the OpenIddict migration and signing
# certificates are provisioned. Native OIDC uses public clients with PKCE;
# there is no client secret in this file.
Authentication__Mobile__Enabled=false
Authentication__Mobile__Issuer=https://api.sonivo.lat

# Leave blank to keep the update gate disabled. When set, both a three-part
# minimum version and the matching HTTPS store URL are required per platform.
Authentication__Mobile__MinimumVersions__Android=
Authentication__Mobile__AndroidStoreUrl=
Authentication__Mobile__MinimumVersions__iOS=
Authentication__Mobile__iOSStoreUrl=
