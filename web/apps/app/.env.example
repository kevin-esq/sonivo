# Next.js BFF (ADR-0067). Never commit real secrets.
# Origin of the .NET API used by next.config.ts rewrites.
API_ORIGIN=http://localhost:5171

# Root domain used by the client host bridge to detect tenant subdomains
# (`{slug}.sonivo.lat` -> /g/{slug}).
NEXT_PUBLIC_ROOT_DOMAIN=sonivo.lat

# Product host. Set to enable the apex -> app handoff redirect (ADR-0067);
# leave unset to keep the apex serving the product directly.
# NEXT_PUBLIC_APP_HOST=app.sonivo.lat
