# Sonivo production environment (Hetzner VPS / Docker Compose).
#
# Copy to `deploy/.env` on the VPS and fill in real values. NEVER commit .env.
# Names use ASP.NET configuration convention: `__` is the nesting separator.
#
# These values feed the API container. Caddy reads API_HOST and ACME_EMAIL.
# The frontend (Vercel) has its own environment: API_ORIGIN=https://api.sonivo.lat.

# ---------------------------------------------------------------------------
# Caddy (reverse proxy / TLS)
# ---------------------------------------------------------------------------
API_HOST=api.sonivo.lat
ACME_EMAIL=ops@sonivo.lat

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Apply EF migrations on container start (Neon prod branch).
SONIVO_MIGRATE_ON_START=true

# Apex origin. MUST be the bare apex so handoff redirects become
# `{slug}.sonivo.lat` (not `{slug}.app.sonivo.lat`).
PublicOrigin=https://sonivo.lat

# ---------------------------------------------------------------------------
# Database — Neon prod branch (pooled URI, SSL required). Secret.
# ---------------------------------------------------------------------------
ConnectionStrings__Default=Host=ep-xxxx-pooler.region.aws.neon.tech;Port=5432;Database=neondb;Username=xxxx;Password=xxxx;SSL Mode=Require;Trust Server Certificate=true

# ---------------------------------------------------------------------------
# Reverse proxy trust — only the compose network may set X-Forwarded-*.
# The subnet is pinned in deploy/docker-compose.yml.
# ---------------------------------------------------------------------------
ForwardedHeaders__KnownNetworks=172.28.0.0/24

# ---------------------------------------------------------------------------
# WebAuthn / passkeys (apex origin). RelyingPartyId is the registrable suffix;
# AllowedOrigins is the explicit origin list — never a wildcard.
# ---------------------------------------------------------------------------
Passkeys__RelyingPartyId=sonivo.lat
Passkeys__AllowedOrigins=https://sonivo.lat,https://app.sonivo.lat

# SignalR origin allow-list. The hub guard compares Origin to the request host;
# list explicit origins here. Never a wildcard.
Security__AllowedHubOrigins=https://sonivo.lat,https://app.sonivo.lat

# ---------------------------------------------------------------------------
# User Google sign-in (separate OAuth client from email sending — ADR-0026).
# Add the prod redirect URIs in GCP:
#   https://sonivo.lat/api/auth/google/response
#   https://app.sonivo.lat/api/auth/google/response
# ---------------------------------------------------------------------------
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# ---------------------------------------------------------------------------
# Transactional email (ADR-0068). Provider is config only; no vendor in source.
# Email__Transport: "api" (HTTP JSON, hosts that block SMTP) or "smtp".
# ---------------------------------------------------------------------------
Email__Transport=api
Email__From=Sonivo <notificaciones@sonivo.lat>
# API transport:
Email__Endpoint=https://api.example-email.com/emails
Email__ApiKey=
# SMTP transport (port 587 = STARTTLS; 465 = implicit TLS with UseStartTls=false):
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__UserName=
Email__Smtp__Password=
Email__Smtp__UseStartTls=true

# ---------------------------------------------------------------------------
# Cloudflare R2 blob backend (ADR-0035) — prod bucket, separate from staging.
# ---------------------------------------------------------------------------
R2__AccountId=
R2__AccessKey=
R2__Secret=
R2__BucketName=sonivo-prod
