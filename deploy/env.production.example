# Copy values into Render → Environment (never commit real secrets).
# Names match ASP.NET configuration (double underscore = nested).

# Neon → Project → Connection details → Connection string
# Use the pooled URI. Require SSL. Replace USER/PASSWORD/HOST/DB from the console.
ConnectionStrings__Default=Host=ep-xxxx.region.aws.neon.tech;Port=5432;Database=neondb;Username=xxxx;Password=xxxx;SSL Mode=Require;Trust Server Certificate=true

ASPNETCORE_ENVIRONMENT=Production

# Apply EF migrations when the container starts (needed on first Render deploy and for DataProtectionKeys).
SONIVO_MIGRATE_ON_START=true

# ASP.NET DataProtection key ring is stored in Postgres (T-OPS-01). Do not set a file path.

# Public join-link origin (required together with Gmail OAuth to send invite email).
PublicOrigin=https://sonivo.onrender.com

# WebAuthn / passkeys (T-SEC-01). RelyingPartyId must be a domain suffix of the
# browser origin; AllowedOrigins is the exact origin the passkey ceremony binds to
# (comma-separated, no trailing slash). Both required on Render for passkey login.
Passkeys__RelyingPartyId=sonivo.onrender.com
Passkeys__AllowedOrigins=https://sonivo.onrender.com

# Transactional email (optional). Leave unset in CI. The provider is an
# infrastructure detail; the code never names a vendor.
# Email__Transport picks the transport: "smtp" (default) or "api".
#   - Use "api" where outbound SMTP is blocked (free serverless tiers block
#     25/465/587): set Email__Endpoint + Email__ApiKey.
#   - Use "smtp" where SMTP egress is allowed: set the Email__Smtp__* values.
Email__Transport=smtp
Email__From=Sonivo <no-reply@sonivo.lat>
# API transport:
Email__Endpoint=https://api.example-email.com/emails
Email__ApiKey=
# SMTP transport (port 587 = STARTTLS; use 465 with UseStartTls=false for TLS):
Email__Smtp__Host=smtp.example-email.com
Email__Smtp__Port=587
Email__Smtp__UserName=
Email__Smtp__Password=
